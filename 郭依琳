<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>郭依琳生日快乐</title>
    <!-- GSAP核心库与拖拽插件 -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.2/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.2/dist/Draggable.min.js"></script>
    <style>
        /* 全局样式与硬件加速配置 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            touch-action: none;
            user-select: none;
            -webkit-user-select: none;
        }
        :root {
            --primary: #f8c8dc;
            --secondary: #e8b4d8;
            --bg: #fff5f8;
            --shadow: rgba(255, 105, 180, 0.2);
        }
        body {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background: var(--bg);
            font-family: "PingFang SC", "Microsoft Yahei", sans-serif;
        }
        /* 封面层 */
        .cover {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 100;
            will-change: transform;
        }
        .cover-title {
            font-size: 2.5rem;
            color: white;
            text-shadow: 0 4px 12px var(--shadow);
            margin-bottom: 2rem;
        }
        .cover-tip {
            font-size: 1.2rem;
            color: rgba(255,255,255,0.8);
            animation: bounce 1.5s infinite;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        /* 场景层 */
        .scene {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            will-change: transform;
        }
        /* 木质桌子 */
        .table {
            position: absolute;
            bottom: 10%;
            left: 50%;
            transform: translateX(-50%);
            width: 280px;
            height: 120px;
            background: #d2b48c;
            border-radius: 10px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            will-change: transform;
        }
        /* 蛋糕容器 */
        .cake-container {
            position: absolute;
            top: -80px;
            left: 50%;
            transform: translateX(-50%);
            will-change: transform;
        }
        /* 三层蛋糕 */
        .cake {
            width: 160px;
            height: 100px;
            background: linear-gradient(180deg, #ff69b4, #ff85c0);
            border-radius: 50% 50% 0 0;
            position: relative;
            box-shadow: 0 4px 12px var(--shadow);
        }
        .cake::before, .cake::after {
            content: '';
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            background: #ff85c0;
            border-radius: 50% 50% 0 0;
        }
        .cake::before {
            width: 120px;
            height: 70px;
            top: -50px;
        }
        .cake::after {
            width: 80px;
            height: 50px;
            top: -100px;
        }
        /* 蜡烛 */
        .candle {
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            width: 12px;
            height: 30px;
            background: white;
            border-radius: 5px;
            box-shadow: 0 0 8px rgba(255,255,255,0.8);
        }
        .flame {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            width: 14px;
            height: 20px;
            background: radial-gradient(circle, #ffd700, #ff6347);
            border-radius: 50%;
            animation: flicker 0.8s infinite alternate;
            will-change: opacity;
        }
        @keyframes flicker {
            0% { transform: translateX(-50%) scale(1); opacity: 1; }
            100% { transform: translateX(-50%) scale(1.1); opacity: 0.9; }
        }
        /* 盘子 */
        .plate {
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 180px;
            height: 30px;
            background: white;
            border-radius: 50%;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        /* 信封 */
        .envelope {
            position: absolute;
            bottom: -60px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 60px;
            background: #ffd700;
            border-radius: 5px;
            cursor: pointer;
            opacity: 0;
            will-change: opacity, transform;
        }
        /* Q版女生 */
        .girl {
            position: absolute;
            bottom: 10%;
            left: 20%;
            width: 60px;
            height: 80px;
            cursor: grab;
            will-change: transform;
        }
        .girl-body {
            width: 60px;
            height: 70px;
            background: #ffb6c1;
            border-radius: 50% 50% 0 0;
            position: relative;
        }
        .girl-face {
            width: 40px;
            height: 40px;
            background: #ffdbac;
            border-radius: 50%;
            position: absolute;
            top: 10px;
            left: 10px;
        }
        .girl-eye {
            width: 6px;
            height: 6px;
            background: #333;
            border-radius: 50%;
            position: absolute;
            top: 15px;
        }
        .girl-eye.left { left: 12px; }
        .girl-eye.right { right: 12px; }
        .girl-mouth {
            width: 12px;
            height: 6px;
            border-bottom: 2px solid #333;
            border-radius: 0 0 12px 12px;
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
        }
        .girl-hair {
            width: 50px;
            height: 20px;
            background: #8b4513;
            border-radius: 50% 50% 0 0;
            position: absolute;
            top: 5px;
            left: 5px;
        }
        /* 信件层 */
        .letter {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255,105,180,0.95);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 200;
            will-change: opacity;
        }
        .letter-content {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            max-width: 80%;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            opacity: 0;
            transform: scale(0.8);
            will-change: opacity, transform;
        }
        .letter-text {
            font-size: 1.5rem;
            line-height: 2;
            color: #333;
            margin-bottom: 1rem;
        }
        .letter-date {
            font-size: 1.2rem;
            color: var(--secondary);
            font-weight: bold;
        }
        /* 粒子效果容器 */
        .particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 150;
        }
        .particle {
            position: absolute;
            width: 10px;
            height: 10px;
            opacity: 0;
            will-change: transform, opacity;
        }
        .particle.heart {
            background: #ff69b4;
            clip-path: path("M10,3 C10,1 8,0 5,0 C2,0 0,1 0,3 C0,6 5,10 5,10 C5,10 10,6 10,3 Z");
        }
        .particle.star {
            background: #ffd700;
            clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
        }
    </style>
</head>
<body>
    <!-- 封面层 -->
    <div class="cover" id="cover">
        <h1 class="cover-title">致最爱的依琳 | 生日快乐</h1>
        <div class="cover-tip">↑ 向上滑动开启祝福</div>
    </div>

    <!-- 场景层 -->
    <div class="scene" id="scene">
        <div class="table"></div>
        <div class="cake-container">
            <div class="cake"></div>
            <div class="candle">
                <div class="flame" id="flame"></div>
            </div>
        </div>
        <div class="plate"></div>
        <div class="envelope" id="envelope"></div>
        <!-- Q版女生 -->
        <div class="girl" id="girl">
            <div class="girl-hair"></div>
            <div class="girl-body">
                <div class="girl-face">
                    <div class="girl-eye left"></div>
                    <div class="girl-eye right"></div>
                    <div class="girl-mouth"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 信件层 -->
    <div class="letter" id="letter">
        <div class="letter-content">
            <div class="letter-text" id="letterText"></div>
            <div class="letter-date">20070723 </div>
        </div>
    </div>

    <!-- 粒子容器 -->
    <div class="particles" id="particles"></div>

    <script>
        // 全局变量
        let isBlown = false;
        let cakeEaten = 0;
        const flame = document.getElementById('flame');
        const girl = document.getElementById('girl');
        const envelope = document.getElementById('envelope');
        const letter = document.getElementById('letter');
        const letterContent = document.querySelector('.letter-content');
        const cover = document.getElementById('cover');
        const scene = document.getElementById('scene');
        const particles = document.getElementById('particles');

        // 1. 上滑开启封面交互
        let startY = 0;
        cover.addEventListener('touchstart', (e) => startY = e.touches[0].clientY);
        cover.addEventListener('touchend', (e) => {
            const moveY = startY - e.changedTouches[0].clientY;
            if (moveY > 50) { // 上滑距离大于50px
                gsap.to(cover, {
                    y: '-100%',
                    duration: 0.8,
                    ease: 'elastic.out(1, 0.8)',
                    onComplete: () => {
                        cover.style.display = 'none';
                        scene.style.display = 'block';
                    }
                });
            }
        });

        // 2. 初始化女生拖拽
        Draggable.create(girl, {
            type: 'x,y',
            bounds: { minX: 0, maxX: window.innerWidth - 60, minY: window.innerHeight - 150, maxY: window.innerHeight - 80 },
            dragClickables: true,
            onPress: function() {
                gsap.to(girl, { scale: 1.1, duration: 0.2 });
            },
            onRelease: function() {
                gsap.to(girl, { scale: 1, duration: 0.3, ease: 'back.out(2)' });
                checkCandleDistance(); // 松手后检测蜡烛距离
                checkCakePosition(); // 检测蛋糕位置
            }
        });

        // 3. 检测女生与蜡烛的距离
        function checkCandleDistance() {
            if (isBlown) return;
            const girlRect = girl.getBoundingClientRect();
            const candleRect = document.querySelector('.candle').getBoundingClientRect();
            const distance = Math.hypot(
                (girlRect.left + 30) - (candleRect.left + 6),
                (girlRect.top + 40) - (candleRect.top + 15)
            );
            if (distance < 50) {
                blowCandle();
            }
        }

        // 4. 吹蜡烛动画
        function blowCandle() {
            isBlown = true;
            // 火焰消失
            gsap.to(flame, { opacity: 0, duration: 0.5 });
            // 女生表情切换为鼓腮
            const mouth = document.querySelector('.girl-mouth');
            gsap.to(mouth, { 
                height: 12, 
                borderBottom: 'none', 
                borderTop: '2px solid #333', 
                borderRadius: '12px 12px 0 0', 
                duration: 0.3 
            });
            // 烟雾粒子效果
            createSmoke();
        }

        // 5. 创建烟雾粒子
        function createSmoke() {
            for (let i = 0; i < 10; i++) {
                const smoke = document.createElement('div');
                smoke.className = 'particle';
                smoke.style.left = `${girl.getBoundingClientRect().left + 30}px`;
                smoke.style.top = `${girl.getBoundingClientRect().top + 20}px`;
                smoke.style.background = 'rgba(255,255,255,0.5)';
                smoke.style.borderRadius = '50%';
                particles.appendChild(smoke);
                gsap.to(smoke, {
                    y: -50 - Math.random() * 50,
                    x: (Math.random() - 0.5) * 40,
                    opacity: 0,
                    duration: 1,
                    onComplete: () => smoke.remove()
                });
            }
        }

        // 6. 
     